# CHODAE KUNG — Supabase backend (anonymous / link-based MVP)
# Copy to .env.local and fill in from your Supabase project → Settings → API.
# Without these, the app runs on bundled sample data (no persistence).

# Project URL + public anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC and never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — KakaoTalk share button. JavaScript key from Kakao Developers (kakao 앱 → 앱 키 → JavaScript 키).
# Register the site domain under 플랫폼 → Web. Without it, the 카톡 button copies the link instead.
NEXT_PUBLIC_KAKAO_JS_KEY=
